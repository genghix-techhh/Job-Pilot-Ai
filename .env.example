APP_NAME="JobPilot AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=UTC
JOBPILOT_TIMEZONE=Asia/Karachi
TRUSTED_PROXIES=

# Leave empty to disable the web /setup page; use `php artisan app:create-owner` instead.
OWNER_SETUP_TOKEN=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobpilot
DB_USERNAME=jobpilot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
# Set false if you run a supervised `php artisan queue:work`
SCHEDULER_RUNS_QUEUE=true

GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_CALL_LIMIT=50
GEMINI_TIMEOUT=30

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Optional Gmail (read-only) monitoring
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional Adzuna (stays disabled until you add credentials and confirm permitted use)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Discovery pacing and limits (all optional)
SCAN_INTERVAL_MINUTES=60
JOB_EXPIRY_DAYS=30
SOURCE_REQUEST_DELAY_MS=400
MAX_JOBS_PER_SOURCE=500
INBOX_SYNC_INTERVAL_MINUTES=30
HTTP_TIMEOUT=15

# AI pacing (free tier friendly; all optional)
AI_JOBS_PER_SCAN=8
AI_JOB_SPACING_SECONDS=8
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=2048

# CV upload limit in KB (default 5 MB)
CV_MAX_KB=5120
